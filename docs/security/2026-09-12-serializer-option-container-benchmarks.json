{
  "title": "Serializer WAMP Options dictionary integrity",
  "date": "2026-09-12",
  "finding": "SA-016",
  "specification": {
    "reference": "https://wamp-proto.org/wamp_latest_ietf.html",
    "requirement": "WAMP defines dict as a map whose keys must be strings and defines PUBLISH, SUBSCRIBE, CALL, CANCEL, REGISTER, INTERRUPT, and YIELD Options fields as dict values."
  },
  "threat_model": [
    "A peer can place a scalar, null, boolean, or list in a required Options slot and have it silently interpreted as absent options.",
    "MessagePack and CBOR peers can use non-string option keys that were previously stringified, changing an invalid wire message into a different accepted message.",
    "Malformed option values and keys must not be reflected in diagnostics."
  ],
  "fix": {
    "container_shape": "All seven option-bearing WAMP messages now require a dictionary across JSON, MessagePack, and CBOR.",
    "key_shape": "MessagePack and CBOR validate actual top-level string keys before conversion. JSON relies on the JSON grammar and jsonDecode, which cannot produce a JSON object with a non-string key.",
    "diagnostics": "Malformed containers and keys produce stable payload-free FormatException messages scoped to the WAMP message name.",
    "hot_paths": "PUBLISH normalizes each valid map once. CANCEL and INTERRUPT validate in place rather than copying valid maps. Empty and implementation-specific string-keyed options retain prior behavior."
  },
  "baseline_source": {
    "commit": "61595d9289619a356ba47aac798afa718c1f610f",
    "candidate": "same commit plus the source hashes recorded below"
  },
