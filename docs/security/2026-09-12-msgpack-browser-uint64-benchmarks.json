{
  "title": "MessagePack browser Uint64 compatibility",
  "date": "2026-09-12",
  "finding": "SA-018",
  "baseline_source": {
    "commit": "e0e3293ccc7db7d6ab458c576756874550cc82a1",
    "candidate": "same commit plus the source hashes recorded below"
  },
  "threat_model": {
    "failure": "msgpack_dart 1.0.1 uses ByteData Uint64 accessors that either throw UnsupportedError or silently round values when compiled with dart2js.",
    "impact": "A browser client could not send or receive valid WAMP IDs above Uint32, including the maximum protocol ID 2^53, and a standalone over-range Uint64 could be rounded into a different identity.",
    "boundary": "The compatibility layer preserves the standard MessagePack Uint64 and Int64 wire encodings and accepts only integers that Dart web can represent exactly when the runtime lacks 64-bit accessors."
  },
  "fix": {
    "normal_path": "The maintained msgpack_dart codec remains the first path for every encode and decode operation.",
    "fallback": "Only a runtime without working ByteData 64-bit accessors uses a bounded recursive collection codec based on two Uint32 words.",
    "exactness": "Unsigned and signed values outside the exact plus or minus 2^53 Dart web range fail closed without lossy arithmetic.",
    "coverage": "Fast-path EVENT and INVOCATION IDs, slow-path PUBLISH IDs and payloads, nested eligible/exclude lists, truncation, and dart2js/Dart2Wasm parity are covered."
  },
