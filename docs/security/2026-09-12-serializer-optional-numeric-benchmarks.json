{
  "title": "Serializer optional numeric field integrity",
  "date": "2026-09-12",
  "finding": "SA-017",
  "specification": {
    "reference": "https://wamp-proto.org/wamp_latest_ietf.html",
    "requirements": [
      "WAMP IDs are integers in the inclusive range 1 through 2^53.",
      "CALL.Options.timeout and INVOCATION.Details.timeout are non-negative integers, where zero disables the timeout.",
      "INVOCATION.Details.caller and EVENT.Details.publisher are session IDs.",
      "INVOCATION.Details.trustlevel and EVENT.Details.trustlevel are non-negative integers."
    ]
  },
  "threat_model": [
    "A peer can send null, boolean, fractional, negative, string, list, or dictionary values in standardized optional numeric fields.",
    "Permissive decoders previously dropped malformed binary values, exposed malformed JSON values, or truncated CBOR numbers.",
    "Malformed values and attacker-controlled text must not be reflected in diagnostics."
  ],
  "fix": {
    "scalar_validation": "JSON, MessagePack, and CBOR now distinguish absent fields from explicit null and enforce WAMP-ID or non-negative-integer semantics.",
    "cbor_boundary": "CBOR accepts a decoded BigInt only for a WAMP ID within 1 through 2^53, preserving the maximum valid ID without truncation.",
    "detail_decoding": "JSON and MessagePack decode EVENT and INVOCATION details in one pass, combining typed extraction, numeric validation, and custom-field preservation.",
    "compatibility": "INVOCATION trustlevel remains available through details.custom; valid optional fields, absent fields, UTF-8 JSON normalization, and lazy payload behavior are unchanged.",
    "diagnostics": "Invalid values produce stable payload-free FormatException messages scoped to the standardized field path."
  },
  "baseline_source": {
