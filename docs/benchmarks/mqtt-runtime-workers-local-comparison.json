  "runnerSource": "\"\"\"Alternate common-client traffic between frozen brokers and Mosquitto.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,os,subprocess,sys,tempfile\nroot=Path(__file__).resolve().parents[2]\nsys.path.insert(0,str(root/'tool'))\nimport run_mqtt_benchmark_gate as gate\nbase=root/'out/mqtt-latest'\nclient=base/'mqtt-client-direct-body'\nnative=base/'native-baseline-9aa.dylib'\nbinaries={'before':base/'mqtt-broker-direct-body-lint','direct':base/'mqtt-broker-direct-body-lint'}\nfor case in ['ws_sustained','ws_v311_sustained']:\n output=base/f'runtime-workers-paired-{case}'\n output.mkdir(exist_ok=True)\n budget=json.loads((root/f'tool/mqtt_native_{case}_benchmark_budget.json').read_text())\n if case=='64k_sustained': budget['messages_per_run']=20000\n transport=budget.get('transport','tcp')\n env=gate.workload_environment(budget,transport)\n env['CONNECTANUM_NATIVE_LIB']=str(native)\n ports={name:gate.available_port() for name in ['before','direct','mosquitto']}\n assert len(set(ports.values()))==3\n logs={name:(output/f'{name}-stderr.log').open('w') for name in ports}\n brokers={};rows=[]\n try:\n  with tempfile.TemporaryDirectory() as temporary:\n   config=Path(temporary)/'mosquitto.conf'\n   config.write_text(gate.mosquitto_config(ports['mosquitto'],transport))\n   for name in ports:\n    command=['mosquitto','-c',str(config)] if name=='mosquitto' else [str(binaries[name]),str(ports[name])]\n    broker_env=dict(env)\n    broker_env.pop('CONNECTANUM_NATIVE_RUNTIME_THREADS',None)\n    if name=='direct': broker_env['CONNECTANUM_NATIVE_RUNTIME_THREADS']='1'\n    brokers[name]=subprocess.Popen(command,env=broker_env,stdin=subprocess.PIPE,stdout=subprocess.DEVNULL,stderr=logs[name])\n    gate.wait_for_listener(ports[name],brokers[name])\n   for repeat in range(1,budget['repetitions']+1):\n    order=['before','direct','mosquitto'] if repeat%2 else ['direct','before','mosquitto']\n    for name in order:\n     before_cpu,_,before_rss=gate.process_metrics(brokers[name].pid)\n     result,client_cpu=gate.run_client_with_cpu(client,ports[name],env)\n     after_cpu,_,after_rss=gate.process_metrics(brokers[name].pid)\n     row=gate.checked_client_row(result,name,repeat,output/f'{name}-stderr.log')\n     assert row['sent']==budget['messages_per_run'] and row['received']==budget['messages_per_run'] and row['duplicates']==0\n     row.update(variant=name,target='mosquitto' if name=='mosquitto' else 'connectanum',run=repeat,broker_cpu_seconds=round(after_cpu-before_cpu,4),broker_rss_bytes=max(before_rss,after_rss),client_cpu_seconds=client_cpu)\n     rows.append(row)\n     (output/'raw.jsonl').write_text(''.join(json.dumps(row,sort_keys=True)+'\\n' for row in rows))\n   for name in binaries:\n    selected=[row for row in rows if row['variant'] in [name,'mosquitto']]\n    summary=gate.compare(selected,budget)\n    summary['provenance']=gate.provenance(binaries[name],client,'mosquitto',native,transport)\n    summary['diagnosticOnly']=True\n    (output/f'{name}-summary.json').write_text(json.dumps(summary,indent=2,sort_keys=True)+'\\n')\n    print(json.dumps({'case':case,'variant':name,'rate':summary['connectanum_delivered_per_sec_median'],'cpu':summary['connectanum_broker_cpu_seconds_median'],'RSS':summary['connectanum_broker_rss_bytes_max'],'rateRatio':summary['throughput_ratio'],'cpuRatio':summary['broker_cpu_ratio']}),flush=True)\n finally:\n  for process in brokers.values(): gate.stop_broker(process)\n  for log in logs.values(): log.close()\n",
