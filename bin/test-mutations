#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
cd_repo_root
dart_workspace_bootstrap
# Match verification's hosted browser setup, without requiring Chrome for VM targets.
if chrome_binary >/dev/null 2>&1; then
  ensure_chrome_env
fi
if [[ "${CONNECTANUM_MUTATIONS_NATIVE:-0}" == "1" ]]; then
  build_native_ffi_test_release
fi
exec python3 tool/run_dart_mutations.py "$@"
