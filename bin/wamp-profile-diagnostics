#!/usr/bin/env bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

usage() {
  cat <<'EOF'
Usage: bin/wamp-profile-diagnostics [--out-dir <dir>] [--router-worker-counts <csv>] [--native-runtime-thread-counts <csv>] [--workload-timeout-ms <ms>]

Runs the canonical WAMP profile diagnostic throughput scenarios:
1. Dart versus native WAMP client implementation throughput
2. Plain versus PPT payload mode throughput
3. Mixed-serializer peer throughput
4. Native WebSocket fragmentation throughput
5. Filesystem-to-WAMP file-transfer throughput and buffered fallbacks
6. Exponent-30 RawSocket frame throughput above 16 MiB
7. Multi-gigabyte filesystem-to-WAMP transfer stress
8. Repeated 128/256 MiB RawSocket frame stress

Each scenario writes transformed bench artifacts. The regular diagnostics use
the strict default transport-counter gate; the heavy transfer scenarios also
enforce checked-in data-window and lifecycle throughput policies. The
representative pub/sub fan-out path has a checked-in release policy under
bin/wamp-profile-validate instead of living in this diagnostic runner.
Workload or gate failures are recorded in diagnostics-summary.tsv. Remaining
scenarios still run, and any failed scenario makes the final exit nonzero.
EOF
}

absolute_path() {
  local path="$1"

  if [[ "$path" == /* ]]; then
    printf '%s\n' "$path"
  else
    printf '%s/%s\n' "$(repo_root)" "$path"
  fi
}

out_dir="$(repo_root)/out/wamp-profile-diagnostics"
router_worker_counts="1"
native_runtime_thread_counts="1"
workload_timeout_ms="300000"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out-dir)
      out_dir="$(absolute_path "$2")"
      shift 2
      ;;
    --router-worker-counts)
      router_worker_counts="$2"
      shift 2
      ;;
    --native-runtime-thread-counts)
      native_runtime_thread_counts="$2"
      shift 2
      ;;
    --workload-timeout-ms)
      workload_timeout_ms="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

require_command cargo
require_command dart
require_command rustc
cd_repo_root

mkdir -p "$out_dir"

build_native_ffi_test_release

if [[ -z "${CONNECTANUM_NATIVE_LIB:-}" ]]; then
  printf 'Failed to resolve CONNECTANUM_NATIVE_LIB for WAMP profile diagnostics.\n' >&2
  exit 1
fi

{
  printf 'date_utc=%s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  printf 'uname=%s\n' "$(uname -a)"
  printf 'rustc=%s\n' "$(rustc -V)"
  printf 'cargo=%s\n' "$(cargo -V)"
  printf 'dart=%s\n' "$(dart --version 2>&1 | tr '\n' ' ')"
  printf 'native_lib=%s\n' "$CONNECTANUM_NATIVE_LIB"
  printf 'router_worker_counts=%s\n' "$router_worker_counts"
  printf 'native_runtime_thread_counts=%s\n' "$native_runtime_thread_counts"
  printf 'workload_timeout_ms=%s\n' "$workload_timeout_ms"
} >"${out_dir%/}/host-info.txt"

hardware_info="${out_dir%/}/hardware-info.txt"
if command -v lscpu >/dev/null 2>&1; then
  LC_ALL=C lscpu >"$hardware_info" 2>&1 || printf '\nCPU information unavailable.\n' >>"$hardware_info"
elif [[ "$(uname -s)" == Darwin ]] && command -v sysctl >/dev/null 2>&1; then
  sysctl machdep.cpu.brand_string hw.model hw.physicalcpu hw.logicalcpu hw.memsize >"$hardware_info" 2>&1 || printf '\nSome CPU information unavailable.\n' >>"$hardware_info"
else
  printf 'CPU information unavailable.\n' >"$hardware_info"
fi

summary_path="${out_dir%/}/diagnostics-summary.tsv"
printf 'scenario\tworkload_exit\tgate_exit\tstatus\n' >"$summary_path"
diagnostics_failed=0

run_diagnostic() {
  local name="$1"
  local scenario="$2"
  local policy="${3:-}"
  local scenario_out="${out_dir%/}/$name"
  local results_path="${scenario_out%/}/bench_results.jsonl"

  scenario="$(absolute_path "$scenario")"

  if [[ ! -f "$scenario" ]]; then
    printf 'Missing WAMP diagnostic scenario: %s\n' "$scenario" >&2
    exit 1
  fi

  mkdir -p "$scenario_out"

  printf 'Running %s...\n' "$name"
  local workload_status=0
  cargo run --release --manifest-path native/bench/Cargo.toml --bin http_stream -- \
    --native-lib "$CONNECTANUM_NATIVE_LIB" \
    --scenario "$scenario" \
    --results "$results_path" \
    --artifact-dir "$scenario_out" \
    --router-worker-counts "$router_worker_counts" \
    --native-runtime-thread-counts "$native_runtime_thread_counts" \
    --workload-timeout-ms "$workload_timeout_ms" || workload_status=$?
  if [[ "$workload_status" -ne 0 ]]; then
    diagnostics_failed=1
    printf '%s\t%s\tnot_run\tworkload_failed\n' "$name" "$workload_status" >>"$summary_path"
    printf 'Workload %s failed (%s); continuing remaining diagnostics.\n' "$name" "$workload_status" >&2
    return 0
  fi

  local gate_args=(
    --summary "${scenario_out%/}/bench_results.summary.json"
  )
  if [[ -n "$policy" ]]; then
    policy="$(absolute_path "$policy")"
    if [[ ! -f "$policy" ]]; then
      printf 'Missing WAMP diagnostic artifact policy: %s\n' "$policy" >&2
      exit 1
    fi
    gate_args+=(--policy "$policy")
    printf 'Checking %s against %s...\n' "$name" "$policy"
  else
    printf 'Checking %s against the default transport-counter gate...\n' "$name"
  fi
  local gate_status=0
  bin/check-bench-artifacts "${gate_args[@]}" || gate_status=$?
  if [[ "$gate_status" -ne 0 ]]; then
    diagnostics_failed=1
    printf '%s\t0\t%s\tgate_failed\n' "$name" "$gate_status" >>"$summary_path"
    printf 'Gate %s failed (%s); continuing remaining diagnostics.\n' "$name" "$gate_status" >&2
  else
    printf '%s\t0\t0\tpassed\n' "$name" >>"$summary_path"
  fi
}

run_diagnostic \
  wamp_client_impl_throughput \
  native/bench/scenarios/wamp_client_impl_throughput.toml

run_diagnostic \
  wamp_payload_mode_throughput \
  native/bench/scenarios/wamp_payload_mode_throughput.toml

run_diagnostic \
  wamp_mixed_serializer_throughput \
  native/bench/scenarios/wamp_mixed_serializer_throughput.toml

run_diagnostic \
  wamp_websocket_fragmentation_throughput \
  native/bench/scenarios/wamp_websocket_fragmentation_throughput.toml \
  native/bench/artifact_gate/wamp_websocket_fragmentation_throughput.json

run_diagnostic \
  wamp_file_transfer_throughput \
  native/bench/scenarios/wamp_file_transfer_throughput.toml \
  native/bench/artifact_gate/wamp_file_transfer_throughput.json

run_diagnostic \
  wamp_large_rawsocket_frames_throughput \
  native/bench/scenarios/wamp_large_rawsocket_frames_throughput.toml

run_diagnostic \
  wamp_file_transfer_heavy \
  native/bench/scenarios/wamp_file_transfer_heavy.toml \
  native/bench/artifact_gate/wamp_file_transfer_heavy.json

run_diagnostic \
  wamp_large_rawsocket_frames_heavy \
  native/bench/scenarios/wamp_large_rawsocket_frames_heavy.toml \
  native/bench/artifact_gate/wamp_large_rawsocket_frames_heavy.json

printf 'WAMP profile diagnostic artifacts written to %s\n' "$out_dir"
if [[ "$diagnostics_failed" -ne 0 ]]; then
  printf 'One or more diagnostics failed; see %s.\n' "$summary_path" >&2
fi
exit "$diagnostics_failed"
