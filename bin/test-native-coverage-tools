#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
cd_repo_root
ensure_rust_env
scope_manifest="$ROOT_DIR/tool/rust_coverage_scope/Cargo.toml"
cargo fmt --manifest-path "$scope_manifest" -- --check
cargo test --manifest-path "$scope_manifest" --locked \
  --target-dir "$ROOT_DIR/out/rust-coverage-scope-target"
python3 tool/test_native_coverage.py
