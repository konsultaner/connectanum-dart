#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
smoke_config="$repo_root/deploy/docker/router_mcp_smoke.yaml"
smoke_client="$repo_root/tool/smoke_router_image_mcp.py"
official_mcp_client_smoke="$repo_root/tool/smoke_official_mcp_client.mjs"
official_mcp_client_version="2.0.0"
mcp_client_command="router_hosted_client"
mcp_compatibility_protocol_version="2025-11-25"
mcp_modern_protocol_version="2026-07-28"
mcp_procedure="wamp.session.count"
mcp_topic="image.smoke.events"
mcp_resource_uri="connectanum://router-image/context"
mcp_resource_template="connectanum://router-image/item/{itemId}"
mcp_resource_template_variables='{"itemId":"package client/✓"}'
mcp_expanded_resource_template_uri="connectanum://router-image/item/package%20client%2F%E2%9C%93"
mcp_dynamic_resource_uri="connectanum://router-image/live-context"
mcp_resource_update_topic="image.smoke.events"
mcp_prompt_name="inspect-router-image"
mcp_prompt_arguments='{"subject":"packaged runtime"}'

usage() {
  printf 'Usage: %s IMAGE\n' "${0##*/}" >&2
}

if [[ "$#" -ne 1 || -z "$1" ]]; then
  usage
  exit 2
fi

for command_name in docker python3 dart node npm; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'Required command is unavailable: %s\n' "$command_name" >&2
    exit 1
  fi
done

image="$1"
container_name="connectanum-router-mcp-smoke-$$"
container_id=''
mcp_client_workspace=''
mcp_client_pub_cache=''
official_mcp_client_workspace=''

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n "$container_id" ]]; then
    if [[ "$status" -ne 0 ]]; then
      printf 'Router image smoke container logs:\n' >&2
      docker logs "$container_id" >&2 || true
    fi
    docker rm --force "$container_id" >/dev/null 2>&1 || true
  fi
  if [[ -n "$mcp_client_workspace" && -d "$mcp_client_workspace" ]]; then
    rm -rf -- "$mcp_client_workspace" || true
  fi
  if [[ -n "$mcp_client_pub_cache" && -d "$mcp_client_pub_cache" ]]; then
    rm -rf -- "$mcp_client_pub_cache" || true
  fi
  if [[ -n "$official_mcp_client_workspace" && -d "$official_mcp_client_workspace" ]]; then
    rm -rf -- "$official_mcp_client_workspace" || true
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

container_id="$(
  docker run --detach \
    --name "$container_name" \
    --publish 127.0.0.1::8080 \
    --volume "$smoke_config:/etc/connectanum/router.yaml:ro" \
    "$image"
)"

host_port=''
for _ in {1..100}; do
  published_address="$(docker port "$container_id" 8080/tcp 2>/dev/null || true)"
  if [[ "$published_address" =~ :([0-9]+)$ ]]; then
    host_port="${BASH_REMATCH[1]}"
    break
  fi
  if ! docker inspect --format '{{.State.Running}}' "$container_id" \
    2>/dev/null | grep -Fxq true; then
    printf 'Router image smoke container exited before publishing port 8080.\n' >&2
    exit 1
  fi
  sleep 0.1
done

if [[ -z "$host_port" ]]; then
  printf 'Router image smoke container did not publish port 8080.\n' >&2
  exit 1
fi

prepare_isolated_package_client() {
  local package_name
  local package_source
  local package_target
  local resolved_command

  mcp_client_workspace="$(mktemp -d "${TMPDIR:-/tmp}/connectanum-router-image-mcp-client-workspace.XXXXXX")"
  mcp_client_pub_cache="$(mktemp -d "${TMPDIR:-/tmp}/connectanum-router-image-mcp-client-pub-cache.XXXXXX")"
  mkdir -p "$mcp_client_workspace/packages"

  cat >"$mcp_client_workspace/pubspec.yaml" <<'EOF'
name: connectanum_mcp_router_image_smoke_workspace
publish_to: none
environment:
  sdk: '^3.9.2'
hooks:
  user_defines:
    connectanum_client:
      CONNECTANUM_SKIP_NATIVE_BUILD: true
workspace:
  - packages/connectanum_core
  - packages/connectanum_client
  - packages/connectanum_mcp
EOF
  if [[ -f "$repo_root/pubspec.lock" ]]; then
    cp "$repo_root/pubspec.lock" "$mcp_client_workspace/pubspec.lock"
  fi

  for package_name in \
    connectanum_core \
    connectanum_client \
    connectanum_mcp; do
    package_source="$repo_root/packages/$package_name"
    package_target="$mcp_client_workspace/packages/$package_name"
    mkdir -p "$package_target"
    cp "$package_source/pubspec.yaml" "$package_target/pubspec.yaml"
    cp -R "$package_source/lib" "$package_target/lib"
    if [[ -d "$package_source/bin" ]]; then
      cp -R "$package_source/bin" "$package_target/bin"
    fi
    if [[ -d "$package_source/hook" ]]; then
      cp -R "$package_source/hook" "$package_target/hook"
    fi
  done

  CONNECTANUM_SKIP_NATIVE_BUILD=true \
    PATH="$mcp_client_pub_cache/bin:$PATH" \
    PUB_CACHE="$mcp_client_pub_cache" \
    dart pub global activate --source path \
    "$mcp_client_workspace/packages/connectanum_mcp" >&2
  resolved_command="$(
    PATH="$mcp_client_pub_cache/bin:$PATH" \
      PUB_CACHE="$mcp_client_pub_cache" \
      command -v "$mcp_client_command" || true
  )"
  if [[ "$resolved_command" != "$mcp_client_pub_cache/bin/$mcp_client_command" ]]; then
    printf 'Expected isolated package client command, got: %s\n' \
      "${resolved_command:-<missing>}" >&2
    return 1
  fi

  printf 'Router Image package client activated in an isolated pub cache.\n'
}

run_official_mcp_client_smoke() {
  local public_endpoint="$1"
  local protected_endpoint="$2"
  local auth_endpoint="$3"
  local summary

  official_mcp_client_workspace="$(mktemp -d "${TMPDIR:-/tmp}/connectanum-official-mcp-client.XXXXXX")"
  cp "$official_mcp_client_smoke" \
    "$official_mcp_client_workspace/smoke_official_mcp_client.mjs"
  npm install \
    --prefix "$official_mcp_client_workspace" \
    --no-audit \
    --no-fund \
    --ignore-scripts \
    "@modelcontextprotocol/client@$official_mcp_client_version" >&2

  summary="$(
    OFFICIAL_MCP_CLIENT_VERSION="$official_mcp_client_version" \
    OFFICIAL_MCP_AUTH_REALM=image.smoke \
    OFFICIAL_MCP_AUTH_ID=image-smoke-agent \
    OFFICIAL_MCP_AUTH_TICKET=image-smoke-ticket \
      node "$official_mcp_client_workspace/smoke_official_mcp_client.mjs" \
      "$public_endpoint" \
      "$protected_endpoint" \
      "$auth_endpoint"
  )"
  for marker in \
    '"officialMcpClientSummary"' \
    '"sdk":"@modelcontextprotocol/client@2.0.0"' \
    '"era":"legacy"' \
    '"era":"modern"' \
    '"sessionId":null' \
    '"sessionTerminated":true' \
    '"protected"' \
    '"authRetrySucceeded":true' \
    '"unauthorizedCalls":1' \
    '"instructionsReceived":true' \
    '"promptRendered":true' \
    '"toolCallSucceeded":true' \
    '"resourceTemplateRead":true' \
    '"resourceTemplateSubscribed":true' \
    '"resourceTemplateUpdateReceived":true' \
    '"resourceTemplateUnsubscribed":true' \
    '"pubSubHandleReturned":true' \
    '"pubSubPublishAcknowledged":true' \
    '"pubSubEventReceived":true' \
    '"pubSubUnsubscribed":true'; do
    if [[ "$summary" != *"$marker"* ]]; then
      printf 'Official MCP client smoke omitted required evidence: %s\n' \
        "$marker" >&2
      printf '%s\n' "$summary" >&2
      return 1
    fi
  done
  for forbidden_marker in \
    'image-smoke-ticket' \
    'router-image-rejected-official-client-token' \
    'using router image context' \
    'Neutral router image MCP runtime smoke endpoint.' \
    '"access_token"'; do
    if [[ "$summary" == *"$forbidden_marker"* ]]; then
      printf 'Official MCP client smoke exposed sensitive material.\n' >&2
      return 1
    fi
  done

  printf 'Official MCP client Router Image evidence: sdk=@modelcontextprotocol/client@%s public=true protected=true bearer_retry=true legacy_session=true legacy_terminated=true modern_sessionless=true catalogs=true resource_read=true resource_template_read=true resource_template_subscribe=true resource_template_update=true resource_template_unsubscribe=true instructions=true prompt_get=true tool_call=true pubsub=true explicit_handle=true structured_content=true.\n' \
    "$official_mcp_client_version"
  printf 'Official MCP client Router Image smoke passed.\n'
}

print_package_client_evidence() {
  local label="$1"
  local protocol_version="$2"
  local mode="$3"
  local auth_evidence="$4"
  local lifecycle_evidence="$5"
  local resource_uri="$6"

  printf '%s Router Image package evidence: protocol=%s mode=%s auth=%s client=globally-activated %s direct_json=true resources=true resource_templates=true prompts=true wamp_meta=true pubsub=true resource_uri=%s prompt=%s.\n' \
    "$label" \
    "$protocol_version" \
    "$mode" \
    "$auth_evidence" \
    "$lifecycle_evidence" \
    "$resource_uri" \
    "$mcp_prompt_name"
}

run_package_client_smoke() {
  local label="$1"
  local endpoint="$2"
  local summary
  shift 2

  summary="$(
    CONNECTANUM_SKIP_NATIVE_BUILD=true \
      PATH="$mcp_client_pub_cache/bin:$PATH" \
      PUB_CACHE="$mcp_client_pub_cache" "$mcp_client_command" \
      --endpoint "$endpoint" \
      --protocol-version "$mcp_compatibility_protocol_version" \
      --wamp-procedure "$mcp_procedure" \
      --wamp-topic "$mcp_topic" \
      --resource-uri "$mcp_resource_uri" \
      --resource-template "$mcp_resource_template" \
      --resource-template-variables "$mcp_resource_template_variables" \
      --prompt "$mcp_prompt_name" \
      --prompt-arguments "$mcp_prompt_arguments" \
      --pubsub-topic "$mcp_topic" \
      --pubsub-event '{"source":"router-image-package-client"}' \
      "$@"
  )"

  for marker in \
    '"directStandardTools"' \
    '"directResources"' \
    '"directResourceTemplates"' \
    '"directResourceTemplateExpansion"' \
    '"directPrompts"' \
    '"directPrompt"' \
    '"directWampMetadata"' \
    '"configuredRegistrationMetadata"' \
    '"configuredSubscriptionMetadata"' \
    '"activeDirectJson"' \
    '"streamable"' \
    '"initializedNotification":{"accepted":true}' \
    '"resourceTemplates"' \
    '"resourceTemplateExpansion"' \
    "$mcp_expanded_resource_template_uri" \
    '"resourceContent"' \
    '"prompts"' \
    '"prompt"' \
    '"pubsub"'; do
    if [[ "$summary" != *"$marker"* ]]; then
      printf '%s package client smoke omitted required evidence: %s\n' \
        "$label" "$marker" >&2
      printf '%s\n' "$summary" >&2
      return 1
    fi
  done

  if [[ "$label" == Protected* && "$summary" != *'"authLifecycle"'* ]]; then
    printf '%s package client smoke omitted auth lifecycle evidence.\n' \
      "$label" >&2
    printf '%s\n' "$summary" >&2
    return 1
  fi

  local resource_template_pages=1
  local resource_pages=1
  local prompt_pages=1
  if [[ "$label" == "Protected JSON-response" ]]; then
    resource_template_pages=2
    resource_pages=2
    prompt_pages=2
  fi
  if [[ "$summary" != *"\"pagesRead\":$resource_template_pages"* ]]; then
    printf '%s package client smoke did not traverse %s resource-template page(s).\n' \
      "$label" "$resource_template_pages" >&2
    printf '%s\n' "$summary" >&2
    return 1
  fi

  for marker in \
    "\"directResourcePagesRead\":$resource_pages" \
    "\"directResourceMethodPagesRead\":$resource_pages" \
    "\"directPromptPagesRead\":$prompt_pages" \
    "\"directPromptMethodPagesRead\":$prompt_pages" \
    "\"activeDirectResourcePagesRead\":$resource_pages" \
    "\"activeDirectResourceMethodPagesRead\":$resource_pages" \
    "\"activeDirectPromptPagesRead\":$prompt_pages" \
    "\"activeDirectPromptMethodPagesRead\":$prompt_pages" \
    "\"streamableResourcePagesRead\":$resource_pages" \
    "\"streamableResourceMethodPagesRead\":$resource_pages" \
    "\"streamablePromptPagesRead\":$prompt_pages" \
    "\"streamablePromptMethodPagesRead\":$prompt_pages"; do
    if [[ "$summary" != *"$marker"* ]]; then
      printf '%s package client smoke omitted catalog pagination evidence: %s\n' \
        "$label" "$marker" >&2
      printf '%s\n' "$summary" >&2
      return 1
    fi
  done

  local auth_evidence="anonymous"
  local lifecycle_evidence="streamable_http=true session_delete=true resource_template_expansion=true"
  lifecycle_evidence+=" resource_template_pages=$resource_template_pages"
  lifecycle_evidence+=" resource_pages=$resource_pages prompt_pages=$prompt_pages"
  if [[ "$label" == Protected* ]]; then
    auth_evidence="router-issued"
    lifecycle_evidence+=" auth_lifecycle=true"
  fi
  if [[ "$label" == "Protected JSON-response" ]]; then
    lifecycle_evidence+=" post_response=json post_sse_cursor=false"
  fi
  print_package_client_evidence \
    "$label" \
    "$mcp_compatibility_protocol_version" \
    "compatibility" \
    "$auth_evidence" \
    "$lifecycle_evidence" \
    "$mcp_resource_uri"
  printf '%s Router Image package client smoke passed.\n' "$label"
}

run_stateless_package_client_smoke() {
  local label="$1"
  local endpoint="$2"
  local summary
  shift 2

  summary="$(
    CONNECTANUM_SKIP_NATIVE_BUILD=true \
      PATH="$mcp_client_pub_cache/bin:$PATH" \
      PUB_CACHE="$mcp_client_pub_cache" "$mcp_client_command" \
      --endpoint "$endpoint" \
      --protocol-version "$mcp_modern_protocol_version" \
      --wamp-procedure "$mcp_procedure" \
      --wamp-topic "$mcp_topic" \
      --resource-uri "$mcp_dynamic_resource_uri" \
      --resource-update-topic "$mcp_resource_update_topic" \
      --resource-update-event '{"source":"router-image-stateless-resource-update"}' \
      --prompt "$mcp_prompt_name" \
      --prompt-arguments "$mcp_prompt_arguments" \
      --pubsub-topic "$mcp_topic" \
      --pubsub-event '{"source":"router-image-stateless-package-client"}' \
      "$@"
  )"

  for marker in \
    '"modernBatchUnsupported"' \
    '"directStandardTools"' \
    '"directResources"' \
    '"directResourceTemplates"' \
    '"directPrompts"' \
    '"directPrompt"' \
    '"directWampMetadata"' \
    '"configuredRegistrationMetadata"' \
    '"configuredSubscriptionMetadata"' \
    '"pubsubTopic"' \
    '"requestScopedResourceSubscription"' \
    '"acknowledged":true' \
    '"notificationReceived":true' \
    '"closedLocally":true' \
    '"stateless"' \
    '"protocolVersion":"2026-07-28"' \
    '"sessionless":true' \
    '"supportedVersions"'; do
    if [[ "$summary" != *"$marker"* ]]; then
      printf '%s stateless package client smoke omitted required evidence: %s\n' \
        "$label" "$marker" >&2
      printf '%s\n' "$summary" >&2
      return 1
    fi
  done

  local auth_evidence="anonymous"
  local lifecycle_evidence="sessionless=true request_listener=true"
  lifecycle_evidence+=" modern_batch_unsupported=true"
  if [[ "$label" == Protected* ]]; then
    auth_evidence="router-issued"
    for marker in \
      '"authLifecycle"' \
      '"refreshedSessionless":true' \
      '"refreshedRequestScopedResourceSubscription"' \
      '"revokedAccessRejected":true' \
      '"revokedRefreshRejected":true'; do
      if [[ "$summary" != *"$marker"* ]]; then
        printf '%s stateless auth lifecycle smoke omitted required evidence: %s\n' \
          "$label" "$marker" >&2
        printf '%s\n' "$summary" >&2
        return 1
      fi
    done
    lifecycle_evidence+=" auth_lifecycle=true refreshed_grant_listener=true"
  fi
  if [[ "$label" == "Protected JSON-response" ]]; then
    lifecycle_evidence+=" post_response=json"
  fi
  print_package_client_evidence \
    "$label" \
    "$mcp_modern_protocol_version" \
    "stateless" \
    "$auth_evidence" \
    "$lifecycle_evidence" \
    "$mcp_dynamic_resource_uri"
  printf '%s Router Image stateless package client smoke passed.\n' \
    "$label"
}

python3 "$smoke_client" \
  --endpoint "http://127.0.0.1:$host_port/mcp" \
  --secure-endpoint "http://127.0.0.1:$host_port/mcp/secure" \
  --json-response-endpoint "http://127.0.0.1:$host_port/mcp/secure-json" \
  --auth-endpoint "http://127.0.0.1:$host_port/auth"

run_official_mcp_client_smoke \
  "http://127.0.0.1:$host_port/mcp" \
  "http://127.0.0.1:$host_port/mcp/secure" \
  "http://127.0.0.1:$host_port/auth"

prepare_isolated_package_client

run_stateless_package_client_smoke "Public" \
  "http://127.0.0.1:$host_port/mcp"
run_stateless_package_client_smoke "Protected" \
  "http://127.0.0.1:$host_port/mcp/secure" \
  --auth-url "http://127.0.0.1:$host_port/auth" \
  --realm image.smoke \
  --auth-id image-smoke-agent \
  --ticket image-smoke-ticket \
  --auth-lifecycle-smoke
run_stateless_package_client_smoke "Protected JSON-response" \
  "http://127.0.0.1:$host_port/mcp/secure-json" \
  --auth-url "http://127.0.0.1:$host_port/auth" \
  --realm image.smoke \
  --auth-id image-smoke-agent \
  --ticket image-smoke-ticket \
  --auth-lifecycle-smoke
run_package_client_smoke "Public" \
  "http://127.0.0.1:$host_port/mcp"
run_package_client_smoke "Protected" \
  "http://127.0.0.1:$host_port/mcp/secure" \
  --auth-url "http://127.0.0.1:$host_port/auth" \
  --realm image.smoke \
  --auth-id image-smoke-agent \
  --ticket image-smoke-ticket \
  --auth-lifecycle-smoke
run_package_client_smoke "Protected JSON-response" \
  "http://127.0.0.1:$host_port/mcp/secure-json" \
  --auth-url "http://127.0.0.1:$host_port/auth" \
  --realm image.smoke \
  --auth-id image-smoke-agent \
  --ticket image-smoke-ticket \
  --auth-lifecycle-smoke
printf 'Router image MCP runtime smoke passed for %s.\n' "$image"
