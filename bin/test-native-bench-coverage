#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
cd_repo_root
ensure_rust_env
coverage_root="${CONNECTANUM_NATIVE_BENCH_COVERAGE_DIR:-$ROOT_DIR/out/coverage-native-bench}"
if [[ "$coverage_root" != /* ]]; then coverage_root="$ROOT_DIR/$coverage_root"; fi
if [[ -e "$coverage_root" ]]; then
  printf 'Choose a fresh CONNECTANUM_NATIVE_BENCH_COVERAGE_DIR.\n' >&2
  exit 2
fi
mkdir -p "$coverage_root"
CONNECTANUM_TEST_LLVM_COVERAGE=1 "$ROOT_DIR/bin/test-native-coverage-tools"
scope_analyzer="$ROOT_DIR/out/rust-coverage-scope-target/debug/connectanum-coverage-scope"
python3 tool/native_coverage.py snapshot --workspace bench --analyzer "$scope_analyzer" \
  --scope "$coverage_root/source-scopes.json"
# A separate target keeps these counters apart from the transport workspace.
CARGO_TARGET_DIR="$coverage_root/target" CARGO_LLVM_COV_TARGET_DIR="$coverage_root/target" \
  cargo llvm-cov --manifest-path native/bench/Cargo.toml --workspace --locked \
  --lcov --output-path "$coverage_root/lcov.info"
python3 tool/native_coverage.py filter --workspace bench --analyzer "$scope_analyzer" \
  --scope "$coverage_root/source-scopes.json" --lcov "$coverage_root/lcov.info" \
  --output "$coverage_root/production.info"
