#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
cd_repo_root
ensure_rust_env
"$ROOT_DIR/bin/test-native-mutation-tools"
cargo build --manifest-path tool/rust_coverage_scope/Cargo.toml --locked \
  --target-dir "$ROOT_DIR/out/rust-coverage-scope-target"
python3 tool/run_native_mutations.py \
  --analyzer "$ROOT_DIR/out/rust-coverage-scope-target/debug/connectanum-coverage-scope" "$@"
